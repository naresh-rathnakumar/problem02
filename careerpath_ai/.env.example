# Ollama Configuration
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Configurable Match Scoring Weights (Must sum to 1.0)
WEIGHT_REQUIRED_TECHNICAL=0.50
WEIGHT_PREFERRED_TECHNICAL=0.20
WEIGHT_PROJECT_EVIDENCE=0.20
WEIGHT_EDUCATION_EXPERIENCE=0.10

# Application Settings
APP_TITLE=CareerPath AI - Your AI-Powered Career Companion
MAX_FILE_SIZE_MB=10
DEBUG_MODE=false
